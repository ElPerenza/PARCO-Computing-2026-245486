#!/bin/bash

#PBS -N run_experiments
#PBS -q short_cpuQ
#PBS -l walltime=1:00:00
#PBS -l ncpus=64
#PBS -l mem=64gb

module load gcc91
g++() {
    g++-9.1.0 "$@"
}
g++ --version

cd "$PBS_O_WORKDIR" # go to the directory where qsub was run
g++ -fopenmp -O3 -march=native -mtune=native -o ./spmv ./src/spmv.cpp ./src/matrix.cpp ./src/benchmark.cpp

echo ""
echo "--------------------------"
echo "--------sequential--------"
echo "--------------------------"
./spmv sequential "$matrix_path" "./results/${matrix_name}_sequential.txt"

OMP_NUM_THREADS=8
echo ""
echo "--------------------------"
echo "--------8 threads---------"
echo "--------------------------"
./spmv parallel "$matrix_path" "./results/${matrix_name}_8threads.txt"

OMP_NUM_THREADS=16
echo ""
echo "--------------------------"
echo "--------16 threads--------"
echo "--------------------------"
./spmv parallel "$matrix_path" "./results/${matrix_name}_16threads.txt"

OMP_NUM_THREADS=32
echo ""
echo "--------------------------"
echo "--------32 threads--------"
echo "--------------------------"
./spmv parallel "$matrix_path" "./results/${matrix_name}_32threads.txt"

OMP_NUM_THREADS=48
echo ""
echo "--------------------------"
echo "--------48 threads--------"
echo "--------------------------"
./spmv parallel "$matrix_path" "./results/${matrix_name}_48threads.txt"

OMP_NUM_THREADS=64
echo ""
echo "--------------------------"
echo "--------64 threads--------"
echo "--------------------------"
./spmv parallel "$matrix_path" "./results/${matrix_name}_64threads.txt"